{
  "name": "loadometer",
  "version": "0.2.3",
  "description": "Profile how long your app spends loading modules (require and import, Node and Bun) as folded stacks you can render into a flame graph.",
  "keywords": [
    "flamegraph",
    "flame-graph",
    "folded-stacks",
    "speedscope",
    "profiler",
    "profiling",
    "performance",
    "perf",
    "imports",
    "import-cost",
    "require",
    "require-hook",
    "module",
    "modules",
    "dependencies",
    "load-time",
    "startup",
    "startup-time",
    "cold-start",
    "bottleneck",
    "tracing",
    "observability",
    "commonjs",
    "cjs",
    "esm",
    "nodejs",
    "node",
    "bun"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./register": {
      "import": "./dist/register.mjs",
      "require": "./dist/register.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts register.ts --format esm,cjs --dts --clean --platform node --target node18",
    "test": "node --test test/index.test.mjs",
    "example:1": "node examples/example-1.cjs",
    "example:2": "LOADOMETER_OUT_FILE=imports.folded node examples/example-2.cjs",
    "example:node-js-cjs": "cd examples/node-js-cjs && node main.js",
    "example:bun-js-cjs": "cd examples/bun-js-cjs && bun main.js",
    "example:node-js-esm": "cd examples/node-js-esm && node --no-warnings --import ../../register.ts main.js",
    "example:bun-js-esm": "cd examples/bun-js-esm && bun --preload ../../register.ts main.js",
    "example:node-ts-cjs": "cd examples/node-ts-cjs && node --no-warnings main.ts",
    "example:bun-ts-cjs": "cd examples/bun-ts-cjs && bun main.ts",
    "example:node-ts-esm": "cd examples/node-ts-esm && node --no-warnings --import ../../register.ts main.ts",
    "example:bun-ts-esm": "cd examples/bun-ts-esm && bun --preload ../../register.ts main.ts",
    "examples": "npm run example:1 && npm run example:2 && npm run example:node-js-cjs && npm run example:bun-js-cjs && npm run example:node-js-esm && npm run example:bun-js-esm && npm run example:node-ts-cjs && npm run example:bun-ts-cjs && npm run example:node-ts-esm && npm run example:bun-ts-esm",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
